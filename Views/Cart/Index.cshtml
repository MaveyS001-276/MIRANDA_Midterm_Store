@model List<MIRANDA_Midterm_Store.Models.CartItem>

<h1>My Cart</h1>

@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <p>
        <strong>Total Items:</strong> @Model.Sum(item => item.Quantity)
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.Name</td>

                    <td>₱@item.Product.Price</td>

                    <td>
                        <form asp-action="UpdateQuantity" method="get">
                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width:80px; display:inline-block;" />

                            <button type="submit"
                                    class="btn btn-primary">
                                Update
                            </button>
                        </form>
                    </td>

                    <td>
                        ₱@(item.Product.Price * item.Quantity)
                    </td>

                    <td>
                        <a asp-action="Remove"
                           asp-route-id="@item.Id"
                           class="btn btn-danger">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>
        Total:
        ₱@Model.Sum(item => item.Product.Price * item.Quantity)
    </h3>
}